{
  "name": "cv",
  "private": true,
  "packageManager": "npm@10.9.0",
  "scripts": {
    "build": "nest build",
    "start": "node dist/server.mjs",

    "contract:emit": "export $(cat .env) && prisma contract emit",
    "db:init": "export $(cat .env)  && prisma db init",
    "db:update": "export $(cat .env) && prisma db update",
    "db:verify": "export $(cat .env) && prisma db verify",
    "migrate": "export $(cat .env) && prisma db migrate",
    "seed-default": "export $(cat .env) && tsx src/seeds/seedAll.ts",
    "migration:plan": "export $(cat .env) && prisma migration plan",
    "migration:show": "export $(cat .env) && prisma migration show",
    "migration:status": "export $(cat .env) && prisma migration status",
    "skills:sync": "export $(cat .env) && prisma skills sync || exit 0",
    "postinstall": "export $(cat .env) && prisma skills sync || exit 0"
  },
  "dependencies": {
    "@apollo/server": "^5.5.1",
    "@as-integrations/express5": "^1.1.2",
    "@nestjs/apollo": "^14.0.0",
    "@nestjs/common": "^12.0.1",
    "@nestjs/core": "^12.0.1",
    "@nestjs/graphql": "^14.0.0",
    "@nestjs/platform-express": "^12.0.1",
    "@prisma/client": "^7.10.0",
    "@prisma/orm-postgres": "8.0.0-rc.8",
    "dataloader": "^2.2.3",
    "express": "^5.2.1",
    "graphql": "^16.14.2",
    "graphql-http": "^1.23.0",
    "reflect-metadata": "^0.2.2",
    "ruru": "^2.0.1",
    "temporal-polyfill": "^1.0.4"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.0",
    "@nestjs/schematics": "^12.0.0",
    "@swc/cli": "^0.8.1",
    "@types/express": "^5.0.6",
    "@types/node": "^25.6.2",
    "dotenv-cli": "^11.0.0",
    "esbuild": "^0.28.1",
    "prisma": "^8.0.0-rc.12",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3"
  },
  "overrides": {
    "effect": "4.0.0-rc.112"
  }
}
